# prediction-engine environment variables
PORT=8004
LOG_LEVEL=info
# predictions_svc role owns the predictions schema (infra-ops init-db);
# search_path must include public for the shared enum types
DATABASE_URL=postgres://predictions_svc:localdev@localhost:5432/bookiebreaker?search_path=predictions,public
REDIS_URL=redis://localhost:6379
STATISTICS_SERVICE_URL=http://localhost:8002
LINES_SERVICE_URL=http://localhost:8001
SIMULATION_SERVICE_URL=http://localhost:8003
MODEL_DIR=./models
# Comma-separated sports whose models bootstrap at startup (Phase 6, ADR-026)
PREDICTION_SPORTS=BASKETBALL
# Champion/challenger serving (Phase 7 Wave 4). Shadow scoring is zero risk
# (shadow rows never reach read paths). AB_SPLIT_PCT > 0 serves the
# challenger as primary for that % of games -- real bankroll exposure.
SHADOW_SCORING_ENABLED=true
AB_SPLIT_PCT=0
PROMOTION_MIN_SAMPLES=300
RETRAIN_STATUS_TTL_SECONDS=86400
# OpenTelemetry (unset disables exporters; compose sets otel-collector:4317)
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_SERVICE_NAME=prediction-engine
